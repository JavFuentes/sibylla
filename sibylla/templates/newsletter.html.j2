<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sibylla</title></head><body style="margin:0;padding:0;background:#FAF7F0;color:#1A1A1A;font-family:Georgia,'Times New Roman',serif;">
<span style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{ preheader }}&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;</span>
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;background:#FAF7F0;"><tr><td align="center" style="padding:24px 10px;">
<table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;max-width:600px;background:#FFFCF6;border:1px solid #DED5C3;">
<tr><td style="padding:30px 34px 20px;text-align:center;border-top:5px solid #8C6D1F;">
<a href="{{ site_url }}/" style="color:#1A1A1A;text-decoration:none;font-family:Georgia,'Times New Roman',serif;font-size:25px;letter-spacing:.22em;text-transform:uppercase;">Sibylla</a>
<p style="margin:8px 0 0;color:#6F695F;font-size:13px;">{{ edicion.generado }}</p></td></tr>
<tr><td style="padding:20px 34px 30px;">
<p style="margin:0 0 9px;color:#8C6D1F;font-size:11px;letter-spacing:.16em;text-transform:uppercase;">{% if respaldo_editorial %}{{ t.seleccion_editorial }}{% else %}{{ t.destacada }}{% endif %} · {{ destacada.section_label }}</p>
<a href="{{ destacada.url }}" style="color:#1A1A1A;text-decoration:underline;text-decoration-color:#B99A4E;font-size:24px;line-height:1.25;font-weight:bold;">{{ destacada.title }}</a>
<p style="margin:8px 0 18px;color:#716B62;font-size:12px;">{{ destacada.source_name }} · {{ destacada.date }} · T{{ destacada.seal_roman }}</p>
<p style="margin:0;color:#2F2D29;font-size:17px;line-height:1.65;">{{ destacada.resumen }}</p>
<table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-top:22px;"><tr><td bgcolor="#8C6D1F" style="background:#8C6D1F;padding:12px 18px;">
<a href="{{ destacada.url }}" style="display:inline-block;color:#FFFFFF;font-size:13px;font-weight:bold;text-decoration:none;">{{ t.leer_original }} →</a>
</td></tr></table>
</td></tr>
{% if breves %}<tr><td style="padding:2px 34px 8px;">
<p style="margin:0;padding:0 0 8px;color:#8C6D1F;font-size:13px;letter-spacing:.14em;text-transform:uppercase;border-bottom:1px solid #B99A4E;">{{ t.en_breve }}</p>
{% for card in breves %}<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"><tr><td style="padding:16px 0;border-bottom:1px solid #E9E1D4;">
<a href="{{ card.url }}" style="color:#1A1A1A;text-decoration:underline;text-decoration-color:#B99A4E;font-size:16px;line-height:1.35;font-weight:bold;">{{ card.title }}</a>
<p style="margin:5px 0 0;color:#716B62;font-size:12px;">{{ card.source_name }} · {{ card.section_label }} · T{{ card.seal_roman }}</p>
</td></tr></table>{% endfor %}
</td></tr>{% endif %}
<tr><td style="padding:28px 34px 32px;text-align:center;color:#716B62;font-size:12px;line-height:1.6;">
<p style="margin:0 0 12px;">{{ footer_motto }}</p>
<p style="margin:0;"><a href="{{ baja_url }}" style="color:#5B5140;">{{ t.footer_baja }}</a> · <a href="{{ site_url }}/?boletin=temas" style="color:#5B5140;">{{ t.footer_gestion }}</a></p>
<p style="margin:8px 0 0;">{{ t.footer_por_que }} <a href="{{ baja_mailto }}" style="color:#5B5140;">email</a></p>
</td></tr></table></td></tr></table></body></html>
