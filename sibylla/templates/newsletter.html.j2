<!doctype html>
<html lang="es"><body style="margin:0;padding:0;background:#FAF7F0;color:#1A1A1A;font-family:Georgia,'Times New Roman',serif;">
<span style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{ preheader }}&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;</span>
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;background:#FAF7F0;"><tr><td align="center" style="padding:24px 10px;">
<table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation" style="width:100%;max-width:600px;background:#FFFCF6;border:1px solid #DED5C3;">
<tr><td style="padding:30px 34px 18px;text-align:center;border-top:5px solid #8C6D1F;">
<a href="{{ site_url }}/" style="color:#1A1A1A;text-decoration:none;font-family:Georgia,'Times New Roman',serif;font-size:25px;letter-spacing:.22em;text-transform:uppercase;">Sibylla</a>
<p style="margin:8px 0 0;color:#6F695F;font-size:13px;">{{ edicion.generado }}</p></td></tr>
<tr><td style="padding:16px 34px 25px;">
<p style="margin:0 0 8px;color:#8C6D1F;font-size:11px;letter-spacing:.18em;text-transform:uppercase;">{{ t.saludo }}</p>
<p style="margin:0;font-size:18px;line-height:1.55;">{{ edicion.sintesis }}</p></td></tr>
{% for seccion in secciones %}<tr><td style="padding:14px 34px 0;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"><tr><td style="padding:0 0 7px;color:#8C6D1F;font-size:13px;letter-spacing:.14em;text-transform:uppercase;border-bottom:1px solid #B99A4E;">{{ seccion.label }}</td></tr>
{% for card in seccion.cards %}<tr><td style="padding:17px 0;border-bottom:1px solid #E9E1D4;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"><tr><td valign="top" style="padding:0 14px 0 0;">
<a href="{{ card.url }}" style="color:#1A1A1A;text-decoration:underline;text-decoration-color:#B99A4E;font-size:17px;line-height:1.35;font-weight:bold;">{{ card.title }}</a>
<p style="margin:5px 0 8px;color:#716B62;font-size:12px;">{{ card.source_name }} · {{ card.date }}</p>
{% set extracto = card.snippet or card.resumen or '' %}{% if extracto %}<p style="margin:0;color:#3B3935;font-size:14px;line-height:1.5;">{{ extracto[:260] }}{% if extracto|length > 260 %}…{% endif %}</p>{% endif %}
<p style="margin:9px 0 0;"><a href="{{ site_url }}/#{{ card.id }}" style="color:#8C6D1F;font-size:12px;text-decoration:none;">{{ t.comentar }} →</a></p>
</td><td width="28" valign="top" align="right" style="width:28px;color:#8C6D1F;font-size:12px;font-weight:bold;">{{ card.seal_roman }}</td></tr></table>
</td></tr>{% endfor %}</table></td></tr>{% endfor %}
<tr><td style="padding:28px 34px 32px;text-align:center;color:#716B62;font-size:12px;line-height:1.6;">
<p style="margin:0 0 12px;">{{ footer_motto }}</p>
<p style="margin:0;"><a href="{{ baja_url }}" style="color:#5B5140;">{{ t.footer_baja }}</a> · <a href="{{ site_url }}/?boletin=temas" style="color:#5B5140;">{{ t.footer_gestion }}</a></p>
<p style="margin:8px 0 0;">{{ t.footer_por_que }} <a href="{{ baja_mailto }}" style="color:#5B5140;">email</a></p>
</td></tr></table></td></tr></table></body></html>
